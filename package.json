{
  "name": "sales-assistant-frontend-service",
  "version": "0.1.0",
  "private": true,
  "$schema": "https://json.schemastore.org/package",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev --webpack",
    "build": "yarn chakra-typegen && next build --webpack",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "husky",
    "postinstall": "chakra typegen src/theme/index.ts",
    "precommit": "bash ./.husky/pre-commit",
    "translations:fallback": "tsx --conditions=react-server scripts/generateTranslationsFallback.ts",
    "local:sync-translations": "DOTENV_CONFIG_PATH=.env.local tsx --conditions=react-server scripts/syncTranslationsOnSanity.ts",
    "cicd:sync-translations": "tsx --conditions=react-server scripts/syncTranslationsOnSanity.ts",
    "chakra-typegen": "chakra typegen src/theme/index.ts",
    "generate-test-users": "tsx scripts/generateUserFixtures.ts",
    "sanity-backup": "DOTENV_CONFIG_PATH=.env.local tsx --conditions=react-server scripts/createBackupForSanityData.ts",
    "cypress": "dotenv -e .env.local -- cypress open"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1136.0",
    "@chakra-ui/cli": "^3.36.0",
    "@chakra-ui/react": "^3.36.1",
    "@commercetools/platform-sdk": "^9.2.0",
    "@commercetools/ts-client": "^5.0.0",
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "^5.7.1",
    "@sanity/image-url": "^2.1.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "html-react-parser": "^6.1.5",
    "js-yaml": "^5.2.1",
    "lodash": "^4.18.1",
    "lottie-react": "2.4.2",
    "lucide-react": "^1.26.0",
    "next": "16.4.2",
    "next-intl": "^4.13.2",
    "next-sanity": "^13.1.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@svgr/webpack": "^8.1.0",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "16.1.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
